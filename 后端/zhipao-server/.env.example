# ============================================================================
# 智跑校园 · 环境变量模板
# ----------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env（同目录）
#   2. 填入你的真实配置
#   3. 重启后端生效
#
# ★ 全部留空也能启动 —— 各功能会自动降级到 Mock / 开发模式
# ★ 不要提交 .env 到 git（已在 .gitignore 中）
# ============================================================================

# ==================== 数据库 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=xyzp
MYSQL_USER=root
MYSQL_PASSWORD=

# ==================== 缓存 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT ====================
# ★ 生产环境必须配置 ≥32 位随机字符串
# 生成方法: openssl rand -base64 48
JWT_SECRET=

# ==================== 微信小程序 ====================
# ★★ 配了这两个，「开发模式」自动关闭，走真实微信登录 ★★
# 配之前：所有人共用固定 openid（方便单机调试）
# 配之后：每个微信号一个 openid（真实多账号）
#
# 获取方式：
#   微信公众平台 → 开发 → 开发管理 → 开发设置 → AppID / AppSecret
#   测试号：https://mp.weixin.qq.com/wxamp/sandbox?doc=1
WX_APP_ID=
WX_APP_SECRET=

# 订阅消息模板 ID（留空则跳过推送）
WX_TMPL_ORDER_ACCEPTED=
WX_TMPL_ORDER_DELIVERED=
WX_TMPL_ORDER_CANCELLED=
WX_TMPL_APPEAL_RESULT=

# ==================== 腾讯位置服务 ====================
# https://lbs.qq.com/dev/console/key/manage
TENCENT_MAP_KEY=

# ==================== 腾讯云（短信 + OCR 共用） ====================
# https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# ★ 必须是国内地域，否则不扣减免费额度
TENCENT_REGION=ap-guangzhou

# 短信（需先购买套餐包，否则报错 1031）
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# OCR（通用印刷体 1000 次/月免费，自动续期）
TENCENT_OCR_ENABLED=true

# ==================== 对象存储 ====================
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# ==================== ★ 双 AI ====================

# ---------- ① 本地 AI（优先，快、免费、数据不出内网）----------
# 部署：https://ollama.com → ollama pull qwen2.5:7b
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ---------- ② 云 AI（兜底）----------
# Token 获取：https://www.coze.cn → 工作空间 → 个人访问令牌
# ⚠️ Token 泄露后请立即在控制台重新生成
COZE_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=
COZE_BOT_ID=

# AI 总开关（false = 只用本地规则库）
AI_ENABLED=true

# ==================== 服务端口 ====================
SERVER_PORT=3000
