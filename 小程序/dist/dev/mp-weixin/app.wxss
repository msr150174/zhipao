/* ============================================================================
   全局样式
   ★ uni-app 不支持 Tailwind 原子类，这里定义等效的语义类
   ============================================================================ */
page {
  background-color: #f5f6f8;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", system-ui, sans-serif;
  height: 100%;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  background-color: #f5f6f8;
  box-sizing: border-box;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.wrap {
  flex-wrap: wrap;
}

/* ---------- 卡片 ---------- */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.card + .card {
  margin-top: 24rpx;
}

/* ---------- 文字 ---------- */
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.subtitle {
  font-size: 28rpx;
  color: #6b7280;
}
.muted {
  font-size: 24rpx;
  color: #6b7280;
}
.primary {
  color: #22c55e;
}
.error {
  color: #ef4444;
}
.warning {
  color: #f59e0b;
}
.bold {
  font-weight: 600;
}
.center-text {
  text-align: center;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
  padding: 0 40rpx;
}
.btn::after {
  border: none;
}
.btn-primary {
  background-color: #22c55e;
  color: #ffffff;
}
.btn-primary:active {
  opacity: 0.9;
}
.btn-outline {
  background-color: transparent;
  color: #22c55e;
  border: 2rpx solid #22c55e;
}
.btn-ghost {
  background-color: #f0f1f3;
  color: #1f2937;
}
.btn-danger {
  background-color: #ef4444;
  color: #ffffff;
}
.btn-disabled {
  background-color: #d8dde4 !important;
  color: #9aa0a6 !important;
}
.btn-block {
  width: 100%;
}

/* ---------- 输入框 ---------- */
.input-wrap {
  background-color: #f3f4f6;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
}
.input {
  width: 100%;
  font-size: 28rpx;
  color: #1f2937;
  background-color: transparent;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.tag-error {
  background-color: #ef4444;
  color: #ffffff;
}
.tag-primary {
  background-color: #e8f8ee;
  color: #22c55e;
}
.tag-gray {
  background-color: #e1e5ea;
  color: #6b7280;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  background-color: #e1e5ea;
  margin: 24rpx 0;
}

/* ---------- 间距工具 ---------- */
.mt-8 {
  margin-top: 8rpx;
}
.mt-16 {
  margin-top: 16rpx;
}
.mt-24 {
  margin-top: 24rpx;
}
.mt-32 {
  margin-top: 32rpx;
}
.mb-8 {
  margin-bottom: 8rpx;
}
.mb-16 {
  margin-bottom: 16rpx;
}
.mb-24 {
  margin-bottom: 24rpx;
}
.px-32 {
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.py-24 {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.gap-16 {
  gap: 16rpx;
}
.gap-24 {
  gap: 24rpx;
}

/* ---------- 动效（对应 Taro 版的 anim-* 类） ---------- */
@keyframes fade-in {
from {
    opacity: 0;
}
to {
    opacity: 1;
}
}
@keyframes slide-up {
from {
    transform: translateY(60rpx);
    opacity: 0;
}
to {
    transform: translateY(0);
    opacity: 1;
}
}
@keyframes pop {
0% {
    transform: scale(0.9);
}
60% {
    transform: scale(1.05);
}
100% {
    transform: scale(1);
}
}
@keyframes pulse-soft {
0%, 100% {
    opacity: 1;
}
50% {
    opacity: 0.55;
}
}
@keyframes shake {
0%, 100% {
    transform: translateX(0);
}
20%, 60% {
    transform: translateX(-12rpx);
}
40%, 80% {
    transform: translateX(12rpx);
}
}
@keyframes float {
0%, 100% {
    transform: translateY(0);
}
50% {
    transform: translateY(-12rpx);
}
}
.anim-fade-in {
  animation: fade-in 0.25s ease-out both;
}
.anim-slide-up {
  animation: slide-up 0.3s ease-out both;
}
.anim-pop {
  animation: pop 0.2s ease-out both;
}
.anim-pulse-soft {
  animation: pulse-soft 1.6s ease-in-out infinite;
}
.anim-shake {
  animation: shake 0.4s ease-out both;
}
.anim-float {
  animation: float 2.5s ease-in-out infinite;
}

/* 按下缩放反馈 */
.press-scale {
  transition: transform 0.12s ease-out, opacity 0.12s ease-out;
}
.press-scale:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ---------- 渐变（对应 Taro 版的 grad-* 类） ---------- */
.grad-brand {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
}
.grad-fresh {
  background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
}
.grad-warm {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}
.grad-cool {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
}
.grad-deep {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
}

/* ---------- 骨架屏微光 ---------- */
.skeleton-shimmer {
  background: linear-gradient(90deg, #9aa0a6 25%, #e1e5ea 37%, #9aa0a6 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s linear infinite;
}
@keyframes shimmer {
0% {
    background-position: -200% 0;
}
100% {
    background-position: 200% 0;
}
}
/* ---------- 遮罩（★ 禁止用 opacity，会淡化子内容） ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
